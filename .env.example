# Copy to .env (never commit .env). Looked up in: current directory,
# next to the packaged exe, then the project root.

# --- Primary database (MySQL) -------------------------------------------
# Either a full URL...
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/rafawa?charset=utf8mb4
# ...or the parts (password must be URL-encoded):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rafawa
DB_USER=rafawa_app
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# --- Optional one-way cloud backup sync ----------------------------------
# CLOUD_DB_HOST=
# CLOUD_DB_PORT=3306
# CLOUD_DB_NAME=
# CLOUD_DB_USER=
# CLOUD_DB_PASSWORD=
# CLOUD_DB_SSL_CA=ca.pem
# CLOUD_SYNC_INTERVAL_SECONDS=90

# --- Backups ---------------------------------------------------------------
# AUTO_BACKUP=1             # one automatic backup per day when the app is opened
# BACKUP_DIR=D:\RafawaBackups
# BACKUP_KEEP=14            # how many recent backups to keep
